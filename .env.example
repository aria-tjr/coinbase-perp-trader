# Copy to .env and fill in. Never commit .env.
# Required values have no default; others show the code default.

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
EXCHANGE_ID=bybit
EXCHANGE_TYPE=swap
DEFAULT_SYMBOL=BTCUSDT
BASE_LEVERAGE=5
MAX_LEVERAGE=25
DAILY_DRAWDOWN_LIMIT=0.05
POSITION_STOP_LOSS=0.006
POSITION_TAKE_PROFIT=0.009
MAX_POSITION_SIZE_PCT=0.01
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=trading_db
TIMESCALE_USER=trading_user
TIMESCALE_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_MARKET_DATA=market-data
KAFKA_TOPIC_SIGNALS=trading-signals
MONITORING_PORT=8000
PROMETHEUS_PORT=9090
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log
TRADING_MODE=paper
PAPER_TRADING_BALANCE=10000
LSTM_MODEL_PATH=models/lstm_predictor.pth
RL_POLICY_PATH=models/rl_policy.pth
TARGET_DAILY_RETURN=0.02
SHARPE_THRESHOLD=2.0
MAX_LATENCY_MS=100
MAX_FUNDING_RATE=0.0025
